# Environment files (real secrets never enter Git)
.env
.env.*
!.env.example

# Python
**/.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Node / frontend build artifacts
**/node_modules/
**/build/
**/.react-router/
**/test-results/
**/playwright-report/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Django runtime output
**/media/
**/staticfiles/
*.sqlite3

# Local-only runtime data and deployment backups
.runtime/
backups/
docker-compose.override.yml
*.log

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
