# Keep repository line endings deterministic.
# CRLF inside Dockerfiles would break `RUN ... \` continuations, so force LF.
* text=auto eol=lf

# Windows-only scripts keep compatible endings
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets are never rewritten
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
